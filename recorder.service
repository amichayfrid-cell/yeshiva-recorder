[Unit]
Description=Torah Recording Auto Classifier Service (ivrit-ai + Gemma)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
# Update User and WorkingDirectory to match your actual server environment
User=amichay
WorkingDirectory=/opt/yeshiva-recorder
ExecStart=/opt/yeshiva-recorder/venv/bin/python3 main.py --all
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
