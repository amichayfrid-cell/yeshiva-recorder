# Python & Virtual Environment
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
.env

# Large Models & Weights
ivrit_model/
*.aria2
dcaa7ecd*

# Audio & Media Files
*.mp3
*.wav
*.m4a
*.aac
*.ogg
*.wma

# Temporary & Working Files
.tmp/
tmp*
*.log
benchmark_*.md
benchmark_*.json

# Data Directories & Logs (Preserve folder structure with .gitkeep)
data/incoming/*
data/sorted/*
data/needs_review/*
data/history.json
data/simulated_usb/
!data/incoming/.gitkeep
!data/sorted/.gitkeep
!data/needs_review/.gitkeep
