Windows Registry Editor Version 5.00

; ==============================================================================
; הוספת תפריט קליק ימני לקבצי שמע - "השאר הערה לאחראי השמע"
; ==============================================================================

; 1. כל סוגי קבצי האודיו
[HKEY_CLASSES_ROOT\SystemFileAssociations\audio\shell\YeshivaAudioFeedback]
@="📝 השאר הערה לאחראי השמע"
"Icon"="shell32.dll,269"

[HKEY_CLASSES_ROOT\SystemFileAssociations\audio\shell\YeshivaAudioFeedback\command]
@="powershell.exe -WindowStyle Hidden -Command \"Start-Process ('http://192.168.1.244:8000/student?file=' + [uri]::EscapeDataString('%1'))\""

; 2. קבצי MP3 ספציפית
[HKEY_CLASSES_ROOT\mp3file\shell\YeshivaAudioFeedback]
@="📝 השאר הערה לאחראי השמע"
"Icon"="shell32.dll,269"

[HKEY_CLASSES_ROOT\mp3file\shell\YeshivaAudioFeedback\command]
@="powershell.exe -WindowStyle Hidden -Command \"Start-Process ('http://192.168.1.244:8000/student?file=' + [uri]::EscapeDataString('%1'))\""

; 3. הרחבת WMP / Groove / תוכנות נגן ברירת מחדל
[HKEY_CLASSES_ROOT\WMP11.AssocFile.MP3\shell\YeshivaAudioFeedback]
@="📝 השאר הערה לאחראי השמע"
"Icon"="shell32.dll,269"

[HKEY_CLASSES_ROOT\WMP11.AssocFile.MP3\shell\YeshivaAudioFeedback\command]
@="powershell.exe -WindowStyle Hidden -Command \"Start-Process ('http://192.168.1.244:8000/student?file=' + [uri]::EscapeDataString('%1'))\""

; 4. תחת סיומת .mp3 ישירה
[HKEY_CLASSES_ROOT\.mp3\shell\YeshivaAudioFeedback]
@="📝 השאר הערה לאחראי השמע"
"Icon"="shell32.dll,269"

[HKEY_CLASSES_ROOT\.mp3\shell\YeshivaAudioFeedback\command]
@="powershell.exe -WindowStyle Hidden -Command \"Start-Process ('http://192.168.1.244:8000/student?file=' + [uri]::EscapeDataString('%1'))\""
