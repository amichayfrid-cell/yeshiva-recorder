@echo off
chcp 65001 >nul
echo ======================================================================
echo   ישיבת מדברה כעדן - התקנת תפריט הערות לשיעורי שמע בווינדוס
echo ======================================================================
echo.
echo מתקין שילוב לחיצה ימנית על קבצי שמע (MP3/WAV/M4A)...
reg import "%~dp0install_context_menu.reg"
if %errorlevel% equ 0 (
    echo.
    echo [✓] ההתקנה הושלמה בהצלחה!
    echo מעכשיו, בלחיצה ימנית על כל קובץ שיעור יופיע: "📝 השאר הערה לאחראי שיעורים".
) else (
    echo.
    echo [X] שגיאה בהחלת הגדרות ה-Registry. נסה להריץ כמנהל מערכת (Run as Administrator).
)
echo.
pause
