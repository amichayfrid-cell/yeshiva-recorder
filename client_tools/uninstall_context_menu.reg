Windows Registry Editor Version 5.00

; ==============================================================================
; Yeshiva Audio Recorder - Uninstaller for Context Menu
; ==============================================================================

[-HKEY_CLASSES_ROOT\SystemFileAssociations\audio\shell\YeshivaShiurNote]
[-HKEY_CLASSES_ROOT\SystemFileAssociations\.mp3\shell\YeshivaShiurNote]
[-HKEY_CLASSES_ROOT\SystemFileAssociations\.wav\shell\YeshivaShiurNote]
[-HKEY_CLASSES_ROOT\SystemFileAssociations\.m4a\shell\YeshivaShiurNote]
