[Unit]
Description=Torah Recording Auto Classifier Service (ivrit-ai + Gemma)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
# Update User and WorkingDirectory to match your actual server environment
User=amichay
WorkingDirectory=/opt/yeshiva-recorder
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=HF_TOKEN=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

[Install]
WantedBy=multi-user.target
